# Fal API key (inference) — https://fal.ai/dashboard/keys
# The frontend never sees this; only the backend uses it.
FAL_KEY=

# Fal ADMIN API key — required for the account/billing (credits) endpoint.
# Fal won't serve billing with a regular inference key, so this must be a
# separate admin key. Also used for the pricing endpoint.
ADMIN_KEY=

# Shared secret every /api/fal/* caller must send back as the x-fal-proxy-key
# header. Required — without a match every request is rejected. Any random
# string will do; generate one with:  openssl rand -hex 32
BACKEND_KEY=

# Comma-separated list of allowed CORS origins.
# In dev: http://localhost:5175
# In prod: your hosted frontend origin(s)
ALLOWED_ORIGINS=http://localhost:5175

# Port for the backend HTTP server.
PORT=8789

# Base URL for Fal's Platform REST API (model search / schema).
# Override only if Fal changes hosts.
FAL_PLATFORM_API_BASE=https://api.fal.ai/v1

# Verbose per-request logging, including a summary of every generation input.
# Off by default; set to 1 while debugging.
DEBUG=0
