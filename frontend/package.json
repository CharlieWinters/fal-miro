{
  "name": "fal-miro-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "npm run typecheck && npm run lint:boundaries",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@mirohq/websdk-types": "latest",
    "@types/node": "^22.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
